# GitHub account whose repos are auto-discovered (FR-1).
GITHUB_OWNER=

# Read-only, fine-grained PAT scoped to the ~27 portfolio repos (ADR-0001).
# Never sent to or readable by the browser.
GITHUB_PORTFOLIO_PAT=

# Second, separate fine-grained PAT: contents:write + metadata:read, scoped
# to this repository only (ADR-0004). Used solely to read/write
# data/portfolio-metadata.json. Never merged with GITHUB_PORTFOLIO_PAT and
# never granted access to any of the ~27 portfolio repos.
GITHUB_METADATA_PAT=
GITHUB_METADATA_REPO=joshaumuthumani/github-project-status
GITHUB_METADATA_PATH=data/portfolio-metadata.json

# Single shared secret gating every route (FR-8). No rotation/expiry story
# for MVP (accepted residual risk, docs/PRD.md §8).
DASHBOARD_BEARER_TOKEN=
